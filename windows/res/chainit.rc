            VALUE "LegalCopyright",   "Built by Qmer"
            VALUE "ProductName",      "ChainIt Sibling"
            VALUE "ProductVersion",   "1.9.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
